/**
 * @file prisma/schema.prisma
 * @description Schéma Prisma pour socialtdl.net.
 *   Modèles : User, Session, Account, Verification (gérés par better-auth)
 *   + ConnectedPlatform, Post, NotificationPrefs (métier SocialTDL)
 *
 *   Nouveau modèle simplifié (post-refonte /compose) :
 *   - Post.platform (String singulier) — 1 post = 1 plateforme
 *   - AgentSession et PostPlatformContent supprimés
 *
 *   Prisma 7 : les URLs de connexion sont définies dans prisma.config.ts (migrations)
 *   et dans lib/prisma.ts via @prisma/adapter-pg (runtime).
 *
 *   Voir prisma.config.ts pour la configuration des migrations.
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7 : provider seul suffit ici — l'URL est passée via prisma.config.ts (CLI)
  // et via l'adapter PrismaPg({ connectionString }) dans PrismaClient (runtime).
  provider = "postgresql"
}

// ─── Modèles better-auth (ne pas renommer les champs — requis par l'adaptateur) ──

/**
 * Utilisateur de l'application.
 * Géré principalement par better-auth (signUp, signIn, etc.).
 * Les champs métier sont ajoutés ici (ex: avatarUrl).
 */
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  avatarUrl       String?
  description     String?   // Bio/description publique du profil (max 500 chars)
  emailVerified   Boolean   @default(false)
  image           String?   // Champ requis par better-auth OAuth (photo de profil Google)
  // ID du workspace Late (profil conteneur qui regroupe les comptes sociaux connectés).
  // Créé automatiquement lors du premier clic "Connecter" sur /settings.
  lateWorkspaceId String?
  /** Étape d'onboarding : 0=connecter réseau, 1=premier post, 2=terminé */
  onboardingStep  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  sessions      Session[]
  accounts      Account[]
  platforms     ConnectedPlatform[]
  notifPrefs    NotificationPrefs?
  media         Media[]
  mediaFolders  MediaFolder[]
  mediaTags     MediaTag[]
  bioPage       BioPage?
  webhookEvents WebhookEvent[]
  notifications Notification[]
  feedbacks     Feedback[]
  // Queue slots stockés chez Zernio (source de vérité unique)

  @@map("users")
}

/**
 * Session utilisateur.
 * Créée par better-auth lors du login, supprimée lors du logout.
 */
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/**
 * Compte OAuth lié à un utilisateur.
 * Ex: compte Google, futur compte GitHub, etc.
 * Un utilisateur peut avoir plusieurs comptes OAuth.
 */
model Account {
  id                   String    @id @default(cuid())
  userId               String
  // better-auth v1 : `accountId` (ID chez le provider) + `providerId` (nom du provider)
  accountId            String    // Ex: ID Google de l'utilisateur, ou userId pour "credential"
  providerId           String    // "google", "credential", etc.
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?   // Hash du mot de passe (providerId "credential")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

/**
 * Tokens de vérification (email, reset password, etc.).
 * Créés par better-auth, supprimés après utilisation.
 */
model Verification {
  id         String   @id @default(cuid())
  identifier String   // email ou userId
  value      String   // Token haché
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ─── Modèles métier SocialTDL ──────────────────────────────────────────────────────

/**
 * Réseau social connecté par l'utilisateur via getlate.dev.
 * Un utilisateur peut connecter plusieurs plateformes.
 * Chaque plateforme a un profil distinct dans getlate.dev.
 */
model ConnectedPlatform {
  id            String   @id @default(cuid())
  userId        String
  platform      String   // "instagram" | "tiktok" | "youtube" | "facebook"
  lateProfileId String   // ID du profil dans l'API getlate.dev
  accountName   String   // Nom affiché ex: "@mon_handle"
  avatarUrl     String?  // Photo de profil de la plateforme
  isActive      Boolean  @default(true)
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un utilisateur ne peut avoir qu'un profil Zernio par plateforme
  @@unique([userId, platform, lateProfileId])
  @@index([userId])
  @@map("connected_platforms")
}

// ─── Posts ──────────────────────────────────────────────────────────────────────
// Les posts sont stockés exclusivement chez Zernio (source de vérité unique).
// Aucune table locale — lecture via GET /v1/posts, écriture via POST/PUT/DELETE /v1/posts.
// Voir modules/posts/types.ts pour l'interface Post normalisée depuis Zernio.

/**
 * Dossier virtuel pour organiser les médias de la galerie.
 * Un dossier appartient à un seul utilisateur.
 * La suppression d'un dossier met folderId à null sur ses médias (SetNull).
 */
model MediaFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media[]

  @@index([userId])
  @@map("media_folders")
}

/**
 * Tag coloré pour étiqueter les médias de la galerie.
 * Un tag appartient à un seul utilisateur.
 * Couleur stockée en hex (ex: "#6366f1").
 * Unicité : un user ne peut pas avoir deux tags du même nom.
 */
model MediaTag {
  id     String  @id @default(cuid())
  userId String
  name   String
  color  String  @default("#6366f1")  // Couleur hex du badge (défaut : indigo)

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media[] @relation("MediaToTag")

  @@unique([userId, name])
  @@index([userId])
  @@map("media_tags")
}

/**
 * Média (image ou vidéo) uploadé par l'utilisateur dans sa galerie personnelle.
 * Stocké dans Supabase Storage (bucket `post-media`, chemin `{userId}/gallery/…`).
 * Un média peut être réutilisé dans plusieurs posts via MediaPicker.
 * Peut être organisé dans un dossier (folderId) et étiqueté avec des tags.
 *
 * Cycle de vie :
 *  1. Upload client → presigned URL `/api/gallery/upload-url`
 *  2. PUT vers Supabase Storage
 *  3. saveMedia() Server Action → entrée créée ici
 *  4. deleteMedia() → supprime Storage + cette entrée
 */
model Media {
  id        String   @id @default(cuid())
  userId    String
  url       String                // URL publique Supabase Storage (permanente)
  filename  String                // Nom affiché dans la galerie
  mimeType  String                // "image/jpeg", "video/mp4", etc.
  size      Int                   // Taille en octets
  createdAt DateTime @default(now())

  // Dossier optionnel — null = pas de dossier (racine)
  folderId  String?
  folder    MediaFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // Tags associés (relation many-to-many)
  tags      MediaTag[]    @relation("MediaToTag")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index standard : tous les médias d'un user
  @@index([userId])
  // Index composé pour la pagination triée par date (requête principale de la galerie)
  @@index([userId, createdAt])
  @@map("media")
}

// ─── Modèles Bio Link ─────────────────────────────────────────────────────────

/**
 * Page "Link in Bio" publique de l'utilisateur.
 * Accessible à l'URL : socialtdl.net/u/{slug}
 * Relation 1-1 avec User (un utilisateur ne peut avoir qu'une seule BioPage).
 *
 * Personnalisation : titre, bio, avatar, thème visuel, couleur d'accent.
 * Les liens sociaux (icônes en bas de page) sont stockés en JSON.
 *
 * Cycle de vie :
 *  1. Création automatique ou manuelle via l'éditeur /biolink
 *  2. Ajout de liens (BioLink) via drag & drop
 *  3. Publication (isPublished = true) → page accessible publiquement
 *  4. Tracking des clics (totalClicks agrégé)
 */
model BioPage {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // URL publique : socialtdl.net/u/{slug}
  slug        String   @unique

  // Personnalisation du profil
  title       String?              // Nom affiché (défaut: user.name). Split sur "\n" pour ligne italique.
  bio         String?              // Description courte (max 300 chars) — baseline uppercase mobile/desktop.
  avatarUrl   String?              // Défaut: user.avatarUrl

  // Handle visible en haut à gauche ("@mimimaze") — si null, fallback sur "@{slug}"
  handle      String?              // max 30 chars, sans le @ (ajouté au rendu)

  // Phrase d'intro affichée dans le panneau frosted desktop (template Mimi Sara)
  // max 200 chars, optionnelle — si null, le bloc est masqué sur desktop.
  tagline     String?

  // Thème visuel
  theme       String   @default("default")  // "default" | "dark" | "gradient" | "minimal" | "neon"
  accentColor String   @default("#6366f1")   // Couleur d'accent (hex)

  // Couleurs personnalisées (null = hérite du thème)
  titleColor  String?                           // Couleur hex du titre (#RRGGBB)
  bioColor    String?                           // Couleur hex de la bio
  linkColor   String?                           // Couleur hex du texte des boutons de liens

  // Personnalisation avancée — polices, boutons, avatar
  fontFamily         String   @default("inter")        // inter|poppins|playfair|space-grotesk|dm-sans|outfit|lora|bebas-neue
  buttonShape        String   @default("rounded-lg")   // rounded-lg|rounded-full|rounded-none
  buttonVariant      String   @default("filled")       // filled|outline|shadow
  avatarShape        String   @default("circle")       // circle|rounded-square|square

  // Fond personnalisé (image ou dégradé custom)
  backgroundImageUrl String?                           // URL image de fond
  gradientFrom       String?                           // Hex dégradé custom (couleur 1)
  gradientTo         String?                           // Hex dégradé custom (couleur 2)

  // Mise en page des liens
  linkSpacing        String   @default("normal")       // compact|normal|airy
  hoverAnimation     String   @default("none")         // none|scale|glow|slide

  // Style de mise en page (structure du header et du contenu)
  headerStyle        String   @default("classic")      // classic|hero|banner|minimal|card

  // Branding et bannière
  bannerUrl          String?                           // URL bannière large en haut
  hideBranding       Boolean  @default(false)          // Masquer "Créé avec SocialTDL"
  faviconUrl         String?                           // Favicon personnalisé

  // Formulaire de contact intégré
  showContactForm    Boolean  @default(false)

  // Dernier template appliqué (null = aucun template, personnalisation manuelle)
  templateId         String?

  // Domaine personnalisé (post-MVP)
  customDomain       String?  @unique

  // SEO (balises meta personnalisées)
  seoTitle       String?
  seoDescription String?

  // Liens vers les réseaux sociaux (icônes en bas de page)
  // Format JSON : [{platform: "instagram", url: "https://..."}, ...]
  socialLinks Json     @default("[]")

  // Statistiques agrégées
  totalClicks Int      @default(0)

  // Publication : la page n'est visible publiquement que si isPublished = true
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Liens individuels (boutons cliquables sur la page)
  links       BioLink[]
  // Messages reçus via le formulaire de contact
  contacts    BioContact[]

  @@index([userId])
  @@map("bio_pages")
}

/**
 * Lien individuel affiché sur une BioPage (bouton cliquable).
 * Chaque lien a un titre, une URL de destination, un ordre d'affichage,
 * et un compteur de clics indépendant.
 *
 * Le champ `position` détermine l'ordre d'affichage (drag & drop).
 * Les liens inactifs (isActive = false) ne sont pas visibles sur la page publique.
 */
model BioLink {
  id           String   @id @default(cuid())
  bioPageId    String
  bioPage      BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  // Type de lien : link (bouton cliquable), header (titre de section),
  // separator (ligne horizontale), video (embed YouTube/TikTok), music (embed Spotify)
  type         String   @default("link")   // link|header|separator|video|music

  title        String                 // Libellé du bouton : "Ma dernière vidéo", "Ma boutique", etc.
  url          String?                // URL de destination (null pour header/separator)
  icon         String?                // Emoji ou nom d'icône Lucide (optionnel)
  thumbnailUrl String?                // Image miniature affichée dans le bouton (optionnel)

  // Planification temporelle : le lien n'est visible que dans la fenêtre [activeFrom, activeUntil]
  activeFrom   DateTime?              // Début de visibilité (null = immédiat)
  activeUntil  DateTime?              // Fin de visibilité (null = permanent)

  // Ordre d'affichage (0 = premier). Modifiable par drag & drop dans l'éditeur.
  position     Int      @default(0)

  // Statistiques : nombre de clics sur ce lien
  clicks       Int      @default(0)

  // Un lien inactif n'apparaît pas sur la page publique (toggle dans l'éditeur)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([bioPageId, position])
  @@map("bio_links")
}

/**
 * Message reçu via le formulaire de contact intégré à la BioPage.
 * Visible uniquement par le propriétaire de la page dans l'éditeur.
 */
model BioContact {
  id          String   @id @default(cuid())
  bioPageId   String
  bioPage     BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  name        String                 // Nom de l'expéditeur
  email       String                 // Email de l'expéditeur
  message     String                 // Contenu du message

  createdAt   DateTime @default(now())

  @@index([bioPageId, createdAt])
  @@map("bio_contacts")
}

/**
 * Préférences de notifications de l'utilisateur.
 * Relation 1-1 avec User, créée lors de l'inscription.
 */
model NotificationPrefs {
  id               String  @id @default(cuid())
  userId           String  @unique
  emailOnFailure   Boolean @default(true)  // Email si publication échoue
  emailWeeklyRecap Boolean @default(true)  // Récapitulatif hebdomadaire

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_prefs")
}

// ─── Modèles Webhooks et Notifications ───────────────────────────────────────

/**
 * Événement webhook reçu de getlate.dev.
 * Stocke le payload brut pour traçabilité et audit.
 * Chaque événement est traité par une fonction Inngest (process-webhook).
 *
 * Types d'événements supportés :
 *   - post.published  → post publié avec succès
 *   - post.failed     → échec de publication
 *   - account.disconnected → compte social déconnecté (token révoqué)
 *
 * Cycle de vie :
 *   1. Réception POST /api/webhooks/late → validation signature → stockage ici
 *   2. Dispatch Inngest event "webhook/received" avec { webhookEventId }
 *   3. Fonction Inngest traite l'event → met à jour processedAt
 */
model WebhookEvent {
  id          String    @id @default(cuid())
  userId      String                        // Utilisateur concerné par l'événement
  eventType   String                        // "post.published" | "post.failed" | "account.disconnected"
  postId      String?                       // ID du post concerné (null pour account.disconnected)
  payload     Json                          // Payload brut reçu de getlate.dev
  processedAt DateTime?                     // Rempli après traitement par Inngest (null = en attente)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@map("webhook_events")
}

/**
 * Notification in-app pour l'utilisateur.
 * Affichée dans le dropdown NotificationBell (Header).
 *
 * Types de notifications :
 *   - post.published       → "Ton post a été publié sur {plateforme}"
 *   - post.failed          → "Échec de publication sur {plateforme}"
 *   - account.disconnected → "Ton compte {plateforme} a été déconnecté"
 *
 * Cycle de vie :
 *   1. Créée par la fonction Inngest process-webhook après traitement
 *   2. Affichée dans NotificationBell (badge count = non lues)
 *   3. Marquée lue via PATCH /api/notifications/[id]/read
 */
model Notification {
  id        String   @id @default(cuid())
  userId    String                         // Destinataire de la notification
  type      String                         // Type d'événement (ex: "post.published")
  title     String                         // Titre court (ex: "Publication réussie")
  message   String                         // Message détaillé
  read      Boolean  @default(false)       // true = notification lue par l'utilisateur
  postId    String?                        // ID du post concerné (lien vers la page du post)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Modèle File d'attente (Queue) ──────────────────────────────────────────

// ─── Queue Slots ────────────────────────────────────────────────────────────────
// Les créneaux de file d'attente sont stockés chez Zernio (source de vérité unique).
// Voir modules/queue/types.ts pour l'interface QueueSlot normalisée.

// ─── Modèle Feedback ────────────────────────────────────────────────────────────

/**
 * Feedback envoyé par un utilisateur connecté.
 * Catégories : general (par défaut), bug, feature, autre.
 * Relation N-1 avec User — un utilisateur peut envoyer plusieurs feedbacks.
 */
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("general")  // "general" | "bug" | "feature" | "autre"
  message   String                        // Contenu du feedback (10–2000 chars)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedback")
}
