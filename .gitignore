# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Bun lockfile — régénéré à chaque install (incompatible entre versions bun)
bun.lock

# pnpm lockfile — bun est le package manager du projet (commit dd5388f)
# Régénéré par erreur si une commande npm/pnpm s'exécute (ex: react-email dev)
pnpm-lock.yaml

# Prévisualisation d'emails rendus en HTML statique (scripts/preview-emails.mjs)
tmp/

# Design handoff bundles (lourds, non nécessaires au runtime — extractions déjà
# intégrées dans public/brand/ et modules/biolink/)
*.zip
!**/node_modules/**/*.zip
